# ==================== LLM模块 ====================
def get_llm():
    api_key = os.getenv("DEEPSEEK_API_KEY")
    if not api_key:
        raise ValueError("Missing DEEPSEEK_API_KEY")
    return ChatOpenAI(
        model="deepseek-chat",
        api_key=api_key,
        base_url="https://api.deepseek.com/v1",
        temperature=0.7
    )

# ==================== Prompt工程模块 ====================
SYSTEM_PROMPT = """你是一个聪明、友好、知识渊博的对话助手。

你的能力：
- 回答各种问题
- 提供帮助和建议
- 进行友好的对话交流

你有以下工具可以使用：
1. get_current_time - 获取当前时间，当用户询问时间相关问题时使用
2. calculate - 数学计算，当用户需要计算时使用
3. search_knowledge - 知识库搜索，回答知识性问题

使用工具的规则：
- 当用户询问时间时，必须调用get_current_time工具
- 当用户需要计算时，使用calculate工具
- 其他情况根据需要决定

请用中文进行友好自然地回复。"""

prompt = ChatPromptTemplate.from_messages([
    ("system", SYSTEM_PROMPT),
    MessagesPlaceholder(variable_name="chat_history", optional=True),
    ("human", "{input}")
])

chain = prompt | get_llm() | StrOutputParser()

# ==================== 工具模块 ====================
def get_current_time(input_str: str = "") -> str:
    """获取当前时间工具"""
    now = datetime.now()
    current_time = now.strftime("%Y年%m月%d日 %H:%M:%S")
    return f"当前时间是：{current_time}"

def calculate(expression: str) -> str:
    """数学计算工具"""
    try:
        # 安全计算
        import ast
        def safe_eval(expr):
            allowed_ops = {ast.Add, ast.Sub, ast.Mult, ast.Div, ast.Pow, ast.USub}
            node = ast.parse(expr, mode='eval')
            for n in ast.walk(node):
                if isinstance(n, ast.Expression):
                    continue
                if isinstance(n, (ast.Constant, ast.Num)):
                    continue
                if isinstance(n, ast.BinOp) and type(n.op) in allowed_ops:
                    continue
                if isinstance(n, ast.UnaryOp) and type(n.op) in allowed_ops:
                    continue
                raise ValueError(f"不支持的操作: {type(n).__name__}")
            return eval(expr)
        
        result = safe_eval(expression)
        return f"计算结果：{expression} = {result}"
    except Exception as e:
        return f"计算错误：{str(e)}"

def search_knowledge(query: str) -> str:
    """知识库搜索工具"""
    knowledge_base = {
        "Python": "Python是一种高级编程语言，以其简洁的语法和强大的生态系统著称。",
        "LangChain": "LangChain是一个用于构建大语言模型应用的框架，提供了记忆、链、代理等功能。",
        "人工智能": "人工智能（AI）是计算机科学的一个分支，致力于创建能够执行通常需要人类智能的任务的系统。"
    }
    for key in knowledge_base:
        if key.lower() in query.lower():
            return knowledge_base[key]
    return f"关于'{query}'的知识库内容正在建设中..."

# 创建工具列表
tools = [
    Tool(
        name="get_current_time",
        func=get_current_time,
        description="获取当前时间，当用户询问现在几点、当前时间等时间相关问题时使用"
    ),
    Tool(
        name="calculate",
        func=calculate,
        description="数学计算工具，计算数学表达式，如1+2、3*4等"
    ),
    Tool(
        name="search_knowledge",
        func=search_knowledge,
        description="知识库搜索，回答知识性问题"
    )
]

# ==================== Agent模块 ====================
def get_agent():
    """初始化Agent"""
    llm = get_llm()
    agent = initialize_agent(
        tools,
        llm,
        agent=AgentType.CHAT_CONVERSATIONAL_REACT_DESCRIPTION,
        verbose=True,
        memory=ConversationBufferMemory(
            memory_key="chat_history",
            return_messages=True
        )
    )
    return agent

# ==================== 记忆管理模块 ====================
class ChatMemoryManager:
    def __init__(self):
        self.memories: Dict[str, ConversationBufferMemory] = {}
    
    def get_memory(self, session_id: str = "default") -> ConversationBufferMemory:
        if session_id not in self.memories:
            self.memories[session_id] = ConversationBufferMemory(
                memory_key="chat_history",
                return_messages=True,
                output_key="output",
                input_key="input"
            )
        return self.memories[session_id]
    
    def save_context(self, session_id: str, input_str: str, output_str: str):
        memory = self.get_memory(session_id)
        memory.save_context({"input": input_str}, {"output": output_str})
    
    def clear_memory(self, session_id: str = "default"):
        if session_id in self.memories:
            self.memories[session_id].clear()
    
    def get_chat_history(self, session_id: str = "default") -> List:
        memory = self.get_memory(session_id)
        return memory.load_memory_variables({}).get("chat_history", [])

memory_manager = ChatMemoryManager()

# ==================== 数据模型 ====================
class ChatMessage(BaseModel):
    role: str = Field(description="消息角色: user 或 assistant")
    content: str = Field(description="消息内容")

class ChatRequest(BaseModel):
    message: str = Field(description="用户消息")
    session_id: str = Field(default="default", description="会话ID")

class ChatResponse(BaseModel):
    response: str = Field(description="AI响应")
    session_id: str = Field(description="会话ID")
    history_count: int = Field(description="历史消息数量")


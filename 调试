@app.post("/chat/memory", response_model=ChatResponse, tags=["对话"])
async def chat_with_memory(request: ChatRequest):
    """
    带记忆的对话接口
    - 使用ConversationBufferMemory管理会话历史
    - 通过session_id区分不同会话
    """
    session_id = request.session_id
    
    try:
        # 获取会话记忆
        memory = memory_manager.get_memory(session_id)
        chat_history = memory.load_memory_variables({}).get("chat_history", [])
        
        # 调用Chain
        response = chain.invoke({
            "input": request.message,
            "chat_history": chat_history
        })
        
        # 保存上下文
        memory.save_context({"input": request.message}, {"output": response})
        
        return ChatResponse(
            response=response,
            session_id=session_id,
            history_count=len(chat_history) // 2 + 1
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/chat/simple", response_model=ChatResponse, tags=["对话"])
async def chat_simple(request: ChatRequest):
    """
    简单对话接口（无记忆）
    """
    try:
        response = chain.invoke({
            "input": request.message,
            "chat_history": []
        })
        
        return ChatResponse(
            response=response,
            session_id=request.session_id,
            history_count=0
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/chat/agent", response_model=ChatResponse, tags=["对话"])
async def chat_with_agent(request: ChatRequest):
    """
    Agent对话接口（支持工具调用）
    - 使用Agent和Tools
    - 可以获取时间、进行计算、搜索知识库
    """
    session_id = request.session_id
    
    try:
        agent = get_agent()
        
        # 如果会话有记忆，加载到Agent
        if session_id in memory_manager.memories:
            history = memory_manager.get_chat_history(session_id)
            for msg in history:
                if isinstance(msg, HumanMessage):
                    agent.memory.chat_memory.add_user_message(msg.content)
                elif isinstance(msg, AIMessage):
                    agent.memory.chat_memory.add_ai_message(msg.content)
        
        # 调用Agent
        response = agent.run(input=request.message)
        
        # 保存到记忆
        memory_manager.save_context(session_id, request.message, response)
        
        # 获取历史长度
        history_count = len(memory_manager.get_chat_history(session_id)) // 2
        
        return ChatResponse(
            response=response,
            session_id=session_id,
            history_count=history_count
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/memory/{session_id}", tags=["记忆管理"])
async def get_session_memory(session_id: str = "default"):
    """
    获取指定会话的记忆历史
    """
    history = memory_manager.get_chat_history(session_id)
    return {
        "session_id": session_id,
        "messages": [
            {"role": "user" if isinstance(msg, HumanMessage) else "assistant", 
             "content": msg.content} 
            for msg in history
        ],
        "count": len(history)
    }

@app.delete("/memory/{session_id}", tags=["记忆管理"])
async def clear_session_memory(session_id: str = "default"):
    """
    清除指定会话的记忆
    """
    memory_manager.clear_memory(session_id)
    return {"message": f"Session {session_id} memory cleared"}

